@model CrimeReportingSystem.Models.CrimeReport

@{
    ViewData["Title"] = "Delete Crime Report";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white">
                    <h2 class="mb-0">Delete Crime Report</h2>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        <strong>Warning:</strong> Are you sure you want to permanently delete this crime report?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Report ID</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">Full Name</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">Crime Type</dt>
                        <dd class="col-sm-8">@Model.CrimeType</dd>

                        <dt class="col-sm-4">Location</dt>
                        <dd class="col-sm-8">@Model.Location</dd>

                        <dt class="col-sm-4">Incident Date</dt>
                        <dd class="col-sm-8">@Model.IncidentDate.ToString("dd-MM-yyyy")</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@Model.Status</dd>
                    </dl>

                    <hr />

                    <form asp-controller="CrimeReports"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                Yes, Delete Report
                            </button>

                            <a asp-controller="CrimeReports"
                               asp-action="Admin"
                               class="btn btn-secondary">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
