@model IEnumerable<CrimeReportingSystem.Models.CrimeReport>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Admin Dashboard</h1>
            <p class="text-muted mb-0">Manage submitted crime reports.</p>
        </div>

        <a asp-controller="CrimeReports"
           asp-action="Index"
           class="btn btn-dark">
            + Report a Crime
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            No crime reports have been submitted yet.
        </div>
    }
    else
    {
        <div class="card shadow border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Full Name</th>
                                <th>Crime Type</th>
                                <th>Location</th>
                                <th>Incident Date</th>
                                <th>Status</th>
                                <th>Reported On</th>
                                <th style="min-width: 150px;">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var report in Model)
                            {
                                <tr>
                                    <td>@report.Id</td>
                                    <td>@report.FullName</td>
                                    <td>@report.CrimeType</td>
                                    <td>@report.Location</td>
                                    <td>@report.IncidentDate.ToString("dd-MM-yyyy")</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @report.Status
                                        </span>
                                    </td>
                                    <td>@report.CreatedAt.ToString("dd-MM-yyyy HH:mm")</td>
                                    <td>
                                        <a asp-controller="CrimeReports"
                                           asp-action="Details"
                                           asp-route-id="@report.Id"
                                           class="btn btn-info btn-sm w-100 mb-2">
                                            View Details
                                        </a>

                                        <a asp-controller="CrimeReports"
                                           asp-action="Delete"
                                           asp-route-id="@report.Id"
                                           class="btn btn-danger btn-sm w-100">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
