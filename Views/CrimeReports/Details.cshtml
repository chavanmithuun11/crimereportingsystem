@model CrimeReportingSystem.Models.CrimeReport

@{
    ViewData["Title"] = "Crime Report Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white">
                    <h2 class="mb-0">Crime Report Details</h2>
                </div>

                <div class="card-body p-4">
                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Report ID</div>
                        <div class="col-md-8">@Model.Id</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Full Name</div>
                        <div class="col-md-8">@Model.FullName</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Crime Type</div>
                        <div class="col-md-8">@Model.CrimeType</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Location</div>
                        <div class="col-md-8">@Model.Location</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Incident Date</div>
                        <div class="col-md-8">@Model.IncidentDate.ToString("dd-MM-yyyy")</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Status</div>
                        <div class="col-md-8">
                            <span class="badge bg-warning text-dark">
                                @Model.Status
                            </span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 fw-bold">Reported On</div>
                        <div class="col-md-8">@Model.CreatedAt.ToString("dd-MM-yyyy HH:mm")</div>
                    </div>

                    <hr />

                    <div class="mb-4">
                        <h5 class="fw-bold">Description</h5>
                        <div class="border rounded p-3 bg-light">
                            @Model.Description
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-controller="CrimeReports"
                           asp-action="Admin"
                           class="btn btn-dark">
                            Back to Dashboard
                        </a>

                        <a asp-controller="CrimeReports"
                           asp-action="Delete"
                           asp-route-id="@Model.Id"
                           class="btn btn-danger">
                            Delete Report
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
